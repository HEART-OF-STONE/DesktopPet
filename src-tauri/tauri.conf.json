{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopPet",
  "version": "0.1.1",
  "identifier": "com.desktop-pet.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "桌边 · DesktopPet", "width": 1040, "height": 760, "minWidth": 800, "minHeight": 620, "center": true },
      { "label": "pet", "url": "index.html?pet=true", "title": "豆包", "width": 400, "height": 430, "visible": false, "transparent": true, "decorations": false, "shadow": false, "resizable": false, "skipTaskbar": true, "alwaysOnTop": true, "focus": false }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
